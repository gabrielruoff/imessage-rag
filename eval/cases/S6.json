{
  "suite": "S6",
  "title": "Group dynamics (get_group_dynamics)",
  "targets": {"routing": 0.9, "accuracy": 0.85, "faithfulness": 1.0, "communication": 0.85},
  "cases": [
    {
      "id": "S6.1",
      "prompt": "Who carries <GROUP>?",
      "expect": {"tools": [{"name": "get_group_dynamics", "args_contains": {"chat_id": "<GROUP>.any_chat_id"}}]},
      "gt": {"recipe": "group_dynamics", "params": {"group": "<GROUP>", "section": "members"}},
      "probe": null,
      "grader_notes": "GT top member by share, with share approximately GT",
      "quality_watch": null
    },
    {
      "id": "S6.2",
