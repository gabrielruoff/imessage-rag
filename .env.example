# Copy to .env and uncomment/edit any value you want to override
# (`make env` does the copy). Every line here is COMMENTED and must stay that
# way -- the copy is verbatim, so an uncommented line becomes a live override.
#
# This file is a bare inventory: variable = its default. It deliberately does
# NOT explain the knobs. `config.py` is the single source of truth for what
# each one means, what it is measured against, and how it interacts with the
# others -- read it there; docs/DECISIONS.md has the history.
#
# Four things worth knowing before you edit anything:
#   * CHAT_MODEL moves the others: ANNOTATE_MODEL / TOPIC_MODEL / WRAPPED_MODEL
#     / NUDGES_MODEL (and their *_THINK / *_TIMEOUT siblings) inherit it when
#     left empty. ANNOTATE_TIMEOUT is the one exception -- it budgets a whole
#     BATCH of chunks, not one turn, so it has its own default (see config.py).
#     EMBED_MODEL never does -- it is dimensioned into
#     chunk_vectors, so changing it means reset_db.py plus a full re-ingest.
#   * A few lines show an OPT-IN value rather than a default, and are marked
#     where they appear: the Apple Foundation Models sentinel block, the
#     hosted-backend model examples, LOCAL_TZ
#     (an example zone) and NUDGES_THINK (a recommendation).
#   * `*_THINK` is tri-state: empty = omit the flag (the model's own default),
#     `false` = send think:false, `true` = force a reasoning pass. Empty is not
#     the same as false, and on a thinking-capable model it is much slower.
#   * The `--- feature: X ---` groupings are opt-in feature families; their
#     *_ENABLED flags default off and gate tool registration or a pipeline
#     build, never a prompt.

# --- DB paths ---
# SOURCE_DB=source_data/chat.db
# SNAPSHOT_DB=source_data/chat_snapshot.db
# TARGET_DB=imessage_analysis.db
# ADDRESS_BOOK_PATH=source_data/address_book.abcddb

# --- CLI progress ---
# PROGRESS_STYLE=auto
# PROGRESS_LOG_EVERY=200

# --- Ollama connectivity ---
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434
# OLLAMA_EMBED_PATH=/api/embed
# OLLAMA_CHAT_PATH=/api/chat
# OLLAMA_TIMEOUT=60
# CHAT_TIMEOUT=300

# --- Models ---
# EMBED_MODEL=nomic-embed-text
# CHAT_MODEL=qwen3.5:4b
# CHAT_THINK=

# --- Apple Foundation Models backend (opt-in, no-Ollama capable) ---
# NOT defaults: point a pipeline at the `apple` sentinel to route it
# through the on-device model (needs macOS 26+, Apple Silicon, Apple
# Intelligence, and `make apple-shim`).
# CHAT_MODEL=apple
# EMBED_MODEL=apple
# ANNOTATE_MODEL=apple
# TOPIC_MODEL=apple
# WRAPPED_MODEL=apple
# APPLE_SHIM_PATH=bin/applefm-shim
# APPLE_TOOL_RESULT_MAX_CHARS=5000
# APPLE_ROUTE_MAX_TOKENS=128
# APPLE_FILL_MAX_TOKENS=256
# APPLE_DIGEST_MAX_TOKENS=512
# APPLE_ANSWER_MAX_TOKENS=0
# APPLE_MAX_TOOL_ITERATIONS=8
# APPLE_NO_PROGRESS_LIMIT=2

# --- Hosted backends (opt-in, paid, uploads text) ---
# NOT defaults: a voyage/ EMBED_MODEL or an openrouter/ ANNOTATE_MODEL sends
# chunk text to that provider and needs its key plus a spend cap
# (HOSTED_BUDGET_USD or --budget; no default). Runbook: docs/DEMO.md.
# EMBED_MODEL=voyage/voyage-4-large
# ANNOTATE_MODEL=openrouter/anthropic/claude-haiku-5.5
# OPEN_ROUTER_API_KEY=
# VOYAGE_API_KEY=
# HOSTED_BUDGET_USD=
# HOSTED_MAX_PARALLEL=1
# HOSTED_LIMIT_RECOVER_AFTER=10
# OPENROUTER_MAX_TOKENS=1024
# HOSTED_TIMEOUT=180
# VOYAGE_TIMEOUT=600
# VOYAGE_POLL_SECONDS=30
# HOSTED_BACKOFF_MAX_SECONDS=60
# VOYAGE_BATCH_PRICE_PER_M=0.0804
# VOYAGE_BATCH_MAX_INPUTS=100000
# VOYAGE_MAX_STALLED_ROUNDS=3
# VOYAGE_SYNC_ATTEMPTS=3
# OPENROUTER_UNPARSEABLE_RETRIES=3
# OPENROUTER_CACHE_CHECK_CALLS=3

# --- Tunables ---
# EMBED_DIM=
# EMBED_DOC_PREFIX="search_document: "
# EMBED_QUERY_PREFIX="search_query: "
# EMBED_BATCH_SIZE=64
# EMBED_MAX_WORKERS=4
# EMBED_COMMIT_EVERY=200
# MAX_TOOL_ITERATIONS=20
# TOOL_RESULT_MAX_CHARS=60000
# DOUBLE_TEXT_MIN_MINUTES=10

# --- Analytics: sessions & response dynamics ---
# SESSION_GAP_MINUTES=60
# INITIATION_GAP_HOURS=12
# ADJACENCY_MINUTES=5
# LATE_NIGHT_START_HOUR=0
# LATE_NIGHT_END_HOUR=5
# LOCAL_TZ=America/New_York   # NOT a default: empty = the system zone

# --- Analytics: lexicon & dyad terms ---
# DYAD_TERM_MIN_USES=5
# DYAD_TERM_MIN_LIFT=5.0
# DYAD_TERM_TOP_K=50

# --- Batch annotation (annotate.py) ---
# ANNOTATE_MODEL=
# ANNOTATE_TOP_DYADS=20
# ANNOTATE_COMMIT_EVERY=50
# ANNOTATE_QUALITY=distilled
# ANNOTATE_THINK=
# ANNOTATE_BATCH_SIZE=0
# ANNOTATE_TIMEOUT=900
# ANNOTATE_WORKERS=4
# ANNOTATE_SEED_TARGET=450
# ANNOTATE_KNN_K=10
# ANNOTATE_KNN_INDEX_CAP=800
# ANNOTATE_BUDGET_MINUTES=
# ANNOTATE_HYBRID_SEED_TARGET=800

# --- Dyad-term curation (annotate.py --terms) ---
# ANNOTATE_TERMS_THINK=
# ANNOTATE_TERMS_BATCH_SIZE=25
# ANNOTATE_TERMS_MAX_FAILURES=3

# --- Topic clustering (topics.py) ---
