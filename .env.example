# Copy to .env and uncomment/edit any values you want to override.
# All variables here have working defaults (see config.py) -- .env is optional.

# --- DB paths ---
# SOURCE_DB=source_data/chat.db
# SNAPSHOT_DB=source_data/chat_snapshot.db
# TARGET_DB=imessage_analysis.db
# ADDRESS_BOOK_PATH=source_data/address_book.abcddb

# --- CLI progress ---
# How the batch CLIs report progress. 'auto' draws a live bar on a terminal
# and falls back to periodic plain lines when piped; 'plain' forces the
# lines; 'off' silences progress (start/summary lines still print).
# PROGRESS_STYLE=auto
# Items between progress lines in plain mode. Never affects commit cadence.
# PROGRESS_LOG_EVERY=200

# --- Ollama connectivity ---
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434
# OLLAMA_EMBED_PATH=/api/embed
# OLLAMA_CHAT_PATH=/api/chat
# OLLAMA_TIMEOUT=60
# CHAT_TIMEOUT=300

# --- Models ---
# EMBED_MODEL=nomic-embed-text
# CHAT_MODEL=gemma4:26b-a4b-it-qat
# Thinking pass for thinking-capable chat models (e.g. qwen3): false disables
# it (much faster), true forces it on. Leave unset for the model's default.
# CHAT_THINK=false

# --- Tunables ---
# Embedding dimension: leave unset to auto-detect the model's native size.
# Setting it truncates+renormalizes (Matryoshka -- MRL-trained models only).
# EMBED_DIM=
# Task prefixes for the embed model. Defaults match nomic-embed-text; set
# both to '' (empty) for models without task prefixes.
# EMBED_DOC_PREFIX="search_document: "
# EMBED_QUERY_PREFIX="search_query: "
# EMBED_BATCH_SIZE=64
# EMBED_MAX_WORKERS=4
# Embedded chunks between commits (resumability granularity on interrupt).
# EMBED_COMMIT_EVERY=200
# MAX_TOOL_ITERATIONS=20
# TOOL_RESULT_MAX_CHARS=60000
# Minimum gap (minutes) between same-sender messages for a double-text.
# DOUBLE_TEXT_MIN_MINUTES=10

# --- Analytics: sessions & response dynamics ---
# Silence (minutes) that closes a session row in the sessions table.
# SESSION_GAP_MINUTES=60
# A session starting after at least this much silence is an initiation.
# INITIATION_GAP_HOURS=12
# Max gap (minutes) for a reply to count as an adjacency in group dynamics.
# ADJACENCY_MINUTES=5
# Local-clock hours [start, end) counted as "late night".
# LATE_NIGHT_START_HOUR=0
# LATE_NIGHT_END_HOUR=5
# IANA timezone for hour/weekday bucketing; empty = system local timezone.
# LOCAL_TZ=America/New_York

# --- Analytics: lexicon & dyad terms ---
# DYAD_TERM_MIN_USES=5
# DYAD_TERM_MIN_LIFT=5.0
# DYAD_TERM_TOP_K=50

# --- Batch annotation (annotate.py) ---
# Empty = CHAT_MODEL. Mixing models in chunk_annotations is refused.
# ANNOTATE_MODEL=
# ANNOTATE_TOP_DYADS=20
# ANNOTATE_COMMIT_EVERY=50
# Speed/quality tradeoff: distilled | fast | balanced | max (see config.py;
# --quality overrides per run). distilled = LLM seed sample + kNN classify
# the whole corpus from embeddings.
# ANNOTATE_QUALITY=distilled
# Preset overrides. ANNOTATE_THINK is Ollama's reasoning control: low/medium/
# high for effort-level models (gpt-oss), true/false for toggle models
# (qwen3) -- gpt-oss returns EMPTY output for false, use the levels.
# ANNOTATE_BATCH_SIZE = chunks per LLM request (fast preset uses 8).
# ANNOTATE_THINK=
# ANNOTATE_BATCH_SIZE=0
# Concurrent LLM requests (needs OLLAMA_NUM_PARALLEL>1 server-side to pay
# off -- `make ollama-start` sets 4; ~2x measured).
# ANNOTATE_WORKERS=4
# Distilled preset: LLM seeds to accumulate before classifying, and the
# number of nearest seeds that vote per chunk.
# ANNOTATE_SEED_TARGET=450
# ANNOTATE_KNN_K=10

# --- Topic clustering (topics.py) ---
# Empty = CHAT_MODEL. Unlike ANNOTATE_MODEL, mixing models across runs is
# fine -- a rebuild just replaces the clustering.
# TOPIC_MODEL=
# Thinking pass for the label pass; unset = inherit CHAT_THINK. Worth forcing
# false on a thinking model: the label is one short JSON object, so thinking
# is pure latency (85s -> 3.2s per call on qwen3:4b).
# TOPIC_THINK=
# Unset = CHAT_TIMEOUT.
# TOPIC_TIMEOUT=
# TOPIC_K=50
# TOPIC_KMEANS_ITERS=15
# Chunks shown per cluster, ranked by similarity to the centroid. Below ~30
# the samples are dominated by the cluster's shortest messages and labels
# degrade to "General Conversation"; much above it, the prompt risks the
# context window (see config.py).
# TOPIC_LABEL_SAMPLES=30

# --- wrapped.py ---
# WRAPPED_MODEL=
# Unset = inherit CHAT_THINK / CHAT_TIMEOUT.
# WRAPPED_THINK=
# WRAPPED_TIMEOUT=
# WRAPPED_TOP_CONTACTS=8
# Auto-exclude contacts silent this long before corpus end (see config.py).
# WRAPPED_SILENT_MONTHS=6
# WRAPPED_SILENT_MIN_MESSAGES=200

# --- Conversation chunking ---
# CHUNK_GAP_MINUTES=60
# CHUNK_MAX_CHARS=2000
# CHUNK_MIN_CHARS=10
# CHUNK_OVERLAP_MESSAGES=2
