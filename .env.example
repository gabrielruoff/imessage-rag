# NUDGE_KIND_WEIGHTS={"unanswered_question": 1.0, "faded_initiator": 0.7, "dormant_tie": 0.6, "dropped_plan": 0.9, "unreciprocated_goodnews": 0.5, "inferred_occasion": 0.8}
# NUDGE_MAX_RESULTS=5

