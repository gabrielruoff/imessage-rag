# Copy to .env and uncomment/edit any values you want to override.
# All variables here have working defaults (see config.py) -- .env is optional.

# --- DB paths ---
# SOURCE_DB=source_data/chat.db
# SNAPSHOT_DB=source_data/chat_snapshot.db
# TARGET_DB=imessage_analysis.db
# ADDRESS_BOOK_PATH=source_data/address_book.abcddb

# --- CLI progress ---
# How the batch CLIs report progress. 'auto' draws a live bar on a terminal
# and falls back to periodic plain lines when piped; 'plain' forces the
# lines; 'off' silences progress (start/summary lines still print).
# PROGRESS_STYLE=auto
# Items between progress lines in plain mode. Never affects commit cadence.
# PROGRESS_LOG_EVERY=200

# --- Ollama connectivity ---
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434
# OLLAMA_EMBED_PATH=/api/embed
# OLLAMA_CHAT_PATH=/api/chat
# OLLAMA_TIMEOUT=60
# CHAT_TIMEOUT=300

# --- Models ---
# Every value shown after '=' is the built-in default from config.py, so an
# uncommented line only matters if you change it. CHAT_MODEL is the one knob
# that moves the others: ANNOTATE_MODEL / TOPIC_MODEL / WRAPPED_MODEL (and
# their *_THINK / *_TIMEOUT siblings) inherit from it when left empty.
# EMBED_MODEL=nomic-embed-text
# CHAT_MODEL=gemma4:26b-a4b-it-qat
# Thinking pass for thinking-capable chat models (e.g. qwen3): false disables
# it (much faster), true forces it on. Default is unset = the model's own
# default (the flag is omitted entirely, which some models require).
# CHAT_THINK=

# --- Tunables ---
# Embedding dimension: leave unset to auto-detect the model's native size.
# Setting it truncates+renormalizes (Matryoshka -- MRL-trained models only).
# EMBED_DIM=
# Task prefixes for the embed model. Defaults match nomic-embed-text; set
# both to '' (empty) for models without task prefixes.
# EMBED_DOC_PREFIX="search_document: "
# EMBED_QUERY_PREFIX="search_query: "
# EMBED_BATCH_SIZE=64
# EMBED_MAX_WORKERS=4
# Embedded chunks between commits (resumability granularity on interrupt).
# EMBED_COMMIT_EVERY=200
# MAX_TOOL_ITERATIONS=20
# TOOL_RESULT_MAX_CHARS=60000
# Minimum gap (minutes) between same-sender messages for a double-text.
# DOUBLE_TEXT_MIN_MINUTES=10

# --- Analytics: sessions & response dynamics ---
# Silence (minutes) that closes a session row in the sessions table.
# SESSION_GAP_MINUTES=60
# A session starting after at least this much silence is an initiation.
# INITIATION_GAP_HOURS=12
# Max gap (minutes) for a reply to count as an adjacency in group dynamics.
# ADJACENCY_MINUTES=5
# Local-clock hours [start, end) counted as "late night".
# LATE_NIGHT_START_HOUR=0
# LATE_NIGHT_END_HOUR=5
# IANA timezone for hour/weekday bucketing; empty = system local timezone.
# LOCAL_TZ=America/New_York

# --- Analytics: lexicon & dyad terms ---
# DYAD_TERM_MIN_USES=5
# DYAD_TERM_MIN_LIFT=5.0
# DYAD_TERM_TOP_K=50

# --- Batch annotation (annotate.py) ---
# Default empty = inherit CHAT_MODEL (so: gemma4:26b-a4b-it-qat). Mixing
# models in chunk_annotations is refused -- switching this means emptying the
# table first.
# ANNOTATE_MODEL=
# ANNOTATE_TOP_DYADS=20
# ANNOTATE_COMMIT_EVERY=50
# Speed/quality tradeoff: distilled | fast | balanced | max (see config.py;
# --quality overrides per run). distilled = LLM seed sample + kNN classify
# the whole corpus from embeddings.
# ANNOTATE_QUALITY=distilled
# Preset overrides. ANNOTATE_THINK is Ollama's reasoning control: low/medium/
# high for effort-level models (gpt-oss), true/false for toggle models
# (qwen3) -- gpt-oss returns EMPTY output for false, use the levels (an empty
# reply to think=false is detected once and the run continues without it).
# 'omit'/'none' send no think flag at all, which is NOT the same as false.
# ANNOTATE_BATCH_SIZE = chunks per LLM request (fast preset uses 8).
# Both default empty/0 = use the ANNOTATE_QUALITY preset's own value.
# ANNOTATE_THINK=
# ANNOTATE_BATCH_SIZE=0
# Per-request timeout for the annotate/terms/seed passes; unset = CHAT_TIMEOUT.
# ANNOTATE_TIMEOUT=
# Concurrent LLM requests (needs OLLAMA_NUM_PARALLEL>1 server-side to pay
# off -- `make ollama-start` sets 4; ~2x measured).
# ANNOTATE_WORKERS=4
# Distilled preset: LLM seeds to accumulate before classifying, and the
# number of nearest seeds that vote per chunk.
# ANNOTATE_SEED_TARGET=450
# ANNOTATE_KNN_K=10

# --- Dyad-term curation (annotate.py --terms) ---
# Term curation is NOT a --quality tier and does NOT read ANNOTATE_THINK: one
# term is a four-way choice answered in one word, so a reasoning pass is pure
# latency (gemma4, same verdict: think=low 282.6s vs think=false 26.2s).
# Empty = false; set 'low' on gpt-oss (it returns EMPTY output for false --
# detected once, after which the run continues with no reasoning control, so
# a mismatch costs a warning rather than a parked corpus). 'omit'/'none'
# sends no flag at all: the model's default reasoning (gemma4: 52.0s).
# ANNOTATE_TERMS_THINK=
# Terms per LLM request (~25x fewer requests; a batch never spans chats).
# ANNOTATE_TERMS_BATCH_SIZE=25
# Failed attempts before a term is parked (dyad_terms.curate_failures) rather
# than retried by every later run. Only a term's own dedicated request can
# fail it, and a run where nothing succeeds aborts without recording any.
# --terms --retry-failed unparks them.
# ANNOTATE_TERMS_MAX_FAILURES=3

# --- Topic clustering (topics.py) ---
# Default empty = inherit CHAT_MODEL (so: gemma4:26b-a4b-it-qat). Unlike
# ANNOTATE_MODEL, mixing models across runs is fine -- a rebuild just replaces
# the clustering.
# TOPIC_MODEL=
# Thinking pass for the label pass; default empty = inherit CHAT_THINK (which
# itself defaults to the model's own default). Worth forcing false on a
# thinking model: the label is one short JSON object, so thinking is pure
# latency (85s -> 3.2s per call on qwen3:4b).
# TOPIC_THINK=
# Default empty = inherit CHAT_TIMEOUT (so: 300 seconds).
# TOPIC_TIMEOUT=
# TOPIC_K=50
# TOPIC_KMEANS_ITERS=15
# Chunks shown per cluster, ranked by similarity to the centroid. Below ~30
# the samples are dominated by the cluster's shortest messages and labels
# degrade to "General Conversation"; much above it, the prompt risks the
# context window (see config.py).
# TOPIC_LABEL_SAMPLES=30

# --- wrapped.py ---
# Default empty = inherit CHAT_MODEL (so: gemma4:26b-a4b-it-qat).
# WRAPPED_MODEL=
# Default empty = inherit CHAT_THINK / CHAT_TIMEOUT (so: model default, 300s).
# WRAPPED_THINK=
# WRAPPED_TIMEOUT=
# WRAPPED_TOP_CONTACTS=8
# Auto-exclude contacts silent this long before corpus end (see config.py).
# WRAPPED_SILENT_MONTHS=6
# WRAPPED_SILENT_MIN_MESSAGES=200

# --- Conversation chunking ---
# CHUNK_GAP_MINUTES=60
# CHUNK_MAX_CHARS=2000
# CHUNK_MIN_CHARS=10
# CHUNK_OVERLAP_MESSAGES=2

# --- Eval gates (eval/evalkit label/gate; RES-70 / F4) ---
# Minimum hand labels a measurement gate needs before a class may be cleared.
# Per-class gold-support floor for kappa tasks (conflict_labels); below it a
# class scores None and is never marked passed. Pinned at 50.
# EVAL_GATE_MIN_LABELS=50
# The floor for precision (detector) tasks (dropped_plan): gold positives a
# class needs in the labeled sample before its precision may clear. Pinned 40.
# EVAL_GATE_MIN_PRECISION_POSITIVES=40
