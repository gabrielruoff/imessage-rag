# Copy to .env and uncomment/edit any values you want to override.
# All variables here have working defaults (see config.py) -- .env is optional.

# --- DB paths ---
# SOURCE_DB=source_data/chat.db
# SNAPSHOT_DB=source_data/chat_snapshot.db
# TARGET_DB=imessage_analysis.db
# ADDRESS_BOOK_PATH=source_data/address_book.abcddb

# --- CLI progress ---
# How the batch CLIs report progress. 'auto' draws a live bar on a terminal
# and falls back to periodic plain lines when piped; 'plain' forces the
# lines; 'off' silences progress (start/summary lines still print).
# PROGRESS_STYLE=auto
# Items between progress lines in plain mode. Never affects commit cadence.
# PROGRESS_LOG_EVERY=200

# --- Ollama connectivity ---
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434
# OLLAMA_EMBED_PATH=/api/embed
# OLLAMA_CHAT_PATH=/api/chat
# OLLAMA_TIMEOUT=60
# CHAT_TIMEOUT=300

# --- Models ---
# Every value shown after '=' is the built-in default from config.py, so an
# uncommented line only matters if you change it. CHAT_MODEL is the one knob
# that moves the others: ANNOTATE_MODEL / TOPIC_MODEL / WRAPPED_MODEL (and
# their *_THINK / *_TIMEOUT siblings) inherit from it when left empty.
# EMBED_MODEL=nomic-embed-text
# CHAT_MODEL=gemma4:26b-a4b-it-qat
# Thinking pass for thinking-capable chat models (e.g. qwen3): false disables
# it (much faster), true forces it on. Default is unset = the model's own
# default (the flag is omitted entirely, which some models require).
# CHAT_THINK=

# --- Apple Foundation Models backend (opt-in, no-Ollama capable) ---
# Route any pipeline through Apple's on-device model (Apple Intelligence,
# Apple Silicon, macOS 26+) by setting its *_MODEL var to the "apple" sentinel.
# Build the shim once first:  make apple-shim
# Full no-Ollama setup (chat + batch pipelines + embeddings all on-device):
# CHAT_MODEL=apple
# EMBED_MODEL=apple
# ANNOTATE_MODEL=apple
# TOPIC_MODEL=apple
# WRAPPED_MODEL=apple
# Notes:
# - Switching EMBED_MODEL (to or from apple) changes the embedding space, so it
#   needs reset_db.py + a re-ingest (the ingest_state embed guard enforces it).
#   Apple embeddings are 512-dim NLContextualEmbedding.
# - Switching ANNOTATE_MODEL trips the chunk_annotations model guard: empty
#   that table (or reset_db.py) before annotating with a different model.
# - The shim's context window is a fixed 4,096 tokens; the apple chat path
#   stages small sessions and digests large tool results automatically.
# APPLE_SHIM_PATH=bin/applefm-shim
# APPLE_TOOL_RESULT_MAX_CHARS=5000
# Per-stage output-token caps for the apple chat orchestrator (forwarded to the
# shim as GenerationOptions.maximumResponseTokens). Bounding a stage's output is
# the FM's one per-call speed lever -- the intermediate stages emit short,
# structured text, so a cap trims latency at no quality cost. 0 = uncapped.
# ANSWER stays uncapped so the user-facing reply is never clipped mid-sentence.
# The shim also prewarms the model at startup (no per-call config).
# APPLE_ROUTE_MAX_TOKENS=128
# APPLE_FILL_MAX_TOKENS=256
# APPLE_DIGEST_MAX_TOKENS=512
# APPLE_ANSWER_MAX_TOKENS=0
# Apple chat loop controls, kept separate from the shared MAX_TOOL_ITERATIONS so
# they never shorten the Ollama tool loop. The on-device model over-iterates on
# near-duplicate calls; a lower ceiling plus a no-progress backoff (stop after N
# consecutive no-signal iterations -- a duplicate, an error, or a zero-row
# result) keeps a turn from spinning.
# APPLE_MAX_TOOL_ITERATIONS=8
# APPLE_NO_PROGRESS_LIMIT=2

# --- Tunables ---
# Embedding dimension: leave unset to auto-detect the model's native size.
# Setting it truncates+renormalizes (Matryoshka -- MRL-trained models only).
# EMBED_DIM=
# Task prefixes for the embed model. Defaults match nomic-embed-text; set
# both to '' (empty) for models without task prefixes.
# EMBED_DOC_PREFIX="search_document: "
# EMBED_QUERY_PREFIX="search_query: "
# EMBED_BATCH_SIZE=64
# EMBED_MAX_WORKERS=4
# Embedded chunks between commits (resumability granularity on interrupt).
# EMBED_COMMIT_EVERY=200
# MAX_TOOL_ITERATIONS=20
# TOOL_RESULT_MAX_CHARS=60000
# Minimum gap (minutes) between same-sender messages for a double-text.
# DOUBLE_TEXT_MIN_MINUTES=10

# --- Analytics: sessions & response dynamics ---
# Silence (minutes) that closes a session row in the sessions table.
# SESSION_GAP_MINUTES=60
# A session starting after at least this much silence is an initiation.
# INITIATION_GAP_HOURS=12
# Max gap (minutes) for a reply to count as an adjacency in group dynamics.
# ADJACENCY_MINUTES=5
# Local-clock hours [start, end) counted as "late night".
# LATE_NIGHT_START_HOUR=0
# LATE_NIGHT_END_HOUR=5
# IANA timezone for hour/weekday bucketing; empty = system local timezone.
# LOCAL_TZ=America/New_York

# --- Analytics: lexicon & dyad terms ---
# DYAD_TERM_MIN_USES=5
# DYAD_TERM_MIN_LIFT=5.0
# DYAD_TERM_TOP_K=50

# --- Batch annotation (annotate.py) ---
# Default empty = inherit CHAT_MODEL (so: gemma4:26b-a4b-it-qat). Mixing
# models in chunk_annotations is refused -- switching this means emptying the
# table first.
# ANNOTATE_MODEL=
# ANNOTATE_TOP_DYADS=20
# ANNOTATE_COMMIT_EVERY=50
# Speed/quality tradeoff: distilled | fast | balanced | max (see config.py;
# --quality overrides per run). distilled = LLM seed sample + kNN classify
# the whole corpus from embeddings.
# ANNOTATE_QUALITY=distilled
# Preset overrides. ANNOTATE_THINK is Ollama's reasoning control: low/medium/
# high for effort-level models (gpt-oss), true/false for toggle models
# (qwen3) -- gpt-oss returns EMPTY output for false, use the levels (an empty
# reply to think=false is detected once and the run continues without it).
# 'omit'/'none' send no think flag at all, which is NOT the same as false.
# ANNOTATE_BATCH_SIZE = chunks per LLM request (fast preset uses 8).
# Both default empty/0 = use the ANNOTATE_QUALITY preset's own value.
# ANNOTATE_THINK=
# ANNOTATE_BATCH_SIZE=0
# Per-request timeout for the annotate/terms/seed passes; unset = CHAT_TIMEOUT.
# ANNOTATE_TIMEOUT=
# Concurrent LLM requests (needs OLLAMA_NUM_PARALLEL>1 server-side to pay
# off -- `make ollama-start` sets 4; ~2x measured).
# ANNOTATE_WORKERS=4
# Distilled preset: LLM seeds to accumulate before classifying, and the
# number of nearest seeds that vote per chunk.
# ANNOTATE_SEED_TARGET=450
# ANNOTATE_KNN_K=10

# --- Dyad-term curation (annotate.py --terms) ---
# Term curation is NOT a --quality tier and does NOT read ANNOTATE_THINK: one
# term is a four-way choice answered in one word, so a reasoning pass is pure
# latency (gemma4, same verdict: think=low 282.6s vs think=false 26.2s).
# Empty = false; set 'low' on gpt-oss (it returns EMPTY output for false --
# detected once, after which the run continues with no reasoning control, so
# a mismatch costs a warning rather than a parked corpus). 'omit'/'none'
# sends no flag at all: the model's default reasoning (gemma4: 52.0s).
# ANNOTATE_TERMS_THINK=
# Terms per LLM request (~25x fewer requests; a batch never spans chats).
# ANNOTATE_TERMS_BATCH_SIZE=25
# Failed attempts before a term is parked (dyad_terms.curate_failures) rather
# than retried by every later run. Only a term's own dedicated request can
# fail it, and a run where nothing succeeds aborts without recording any.
# --terms --retry-failed unparks them.
# ANNOTATE_TERMS_MAX_FAILURES=3

# --- Topic clustering (topics.py) ---
# Default empty = inherit CHAT_MODEL (so: gemma4:26b-a4b-it-qat). Unlike
# ANNOTATE_MODEL, mixing models across runs is fine -- a rebuild just replaces
# the clustering.
# TOPIC_MODEL=
# Thinking pass for the label pass; default empty = inherit CHAT_THINK (which
# itself defaults to the model's own default). Worth forcing false on a
# thinking model: the label is one short JSON object, so thinking is pure
# latency (85s -> 3.2s per call on qwen3:4b).
# TOPIC_THINK=
# Default empty = inherit CHAT_TIMEOUT (so: 300 seconds).
# TOPIC_TIMEOUT=
# TOPIC_K=50
# TOPIC_KMEANS_ITERS=15
# Chunks shown per cluster, ranked by similarity to the centroid. Below ~30
# the samples are dominated by the cluster's shortest messages and labels
# degrade to "General Conversation"; much above it, the prompt risks the
# context window (see config.py).
# TOPIC_LABEL_SAMPLES=30

# --- wrapped.py ---
# Default empty = inherit CHAT_MODEL (so: gemma4:26b-a4b-it-qat).
# WRAPPED_MODEL=
# Default empty = inherit CHAT_THINK / CHAT_TIMEOUT (so: model default, 300s).
# WRAPPED_THINK=
# WRAPPED_TIMEOUT=
# WRAPPED_TOP_CONTACTS=8
# Auto-exclude contacts silent this long before corpus end (see config.py).
# WRAPPED_SILENT_MONTHS=6
# WRAPPED_SILENT_MIN_MESSAGES=200
# Consent list for the "Your Voiceprint" guess-who game (RES-64 / V4): comma/
# space-separated contacts.id values OK to include. Empty (default) = self-only;
# NO third-party text or card in the file. Consent adds, never overrides an
# exclusion. Parsed via consent.parse_consent_ids.
# WRAPPED_VOICEPRINT_CONSENT_IDS=
# --- feature: wellbeing ---
# Opt-in wellbeing trajectory section (RES-68 / W4). OFF by default; set true
# (or pass wrapped.py --wellbeing, which overrides this for the run) to include
# it. On a flagged window it carries the same code-emitted support footer as the
# chat surface and all its narration is sanitized before rendering.
# WRAPPED_WELLBEING=false
# --- end feature: wellbeing ---

# --- Conversation chunking ---
# CHUNK_GAP_MINUTES=60
# CHUNK_MAX_CHARS=2000
# CHUNK_MIN_CHARS=10
# CHUNK_OVERLAP_MESSAGES=2

# --- Eval gates (eval/evalkit label/gate; RES-70 / F4) ---
# Minimum hand labels a measurement gate needs before a class may be cleared.
# Per-class gold-support floor for kappa tasks (conflict_labels); below it a
# class scores None and is never marked passed. Pinned at 50.
# EVAL_GATE_MIN_LABELS=50
# The floor for precision (detector) tasks (dropped_plan): gold positives a
# class needs in the labeled sample before its precision may clear. Pinned 40.
# EVAL_GATE_MIN_PRECISION_POSITIVES=40
# --- feature: nudges ---
# --- Loose Ends / nudges (loose_ends.py) ---
# Model/think/timeout for the one-line nudge_text narration ONLY (detectors are
# model-free SQL). Default empty = inherit CHAT_MODEL / CHAT_THINK / CHAT_TIMEOUT.
# NOTE: with gemma4, leave NUDGES_THINK unset and it inherits the flag-omitted
# default, which makes gemma run a FULL reasoning pass on every one-liner (~11x
# latency for identical output -- a 20-thread run goes from ~10min to hours). Set
# it false, like ANNOTATE/TOPIC/WRAPPED_THINK, unless your narration model needs
# the flag omitted.
# NUDGES_MODEL=
# NUDGES_THINK=false
# NUDGES_TIMEOUT=
# Stage-0 auto-exclusion: most-recent llm-annotated exchange with mean valence
# <= this is dropped (only source='llm' chunk_annotations count).
# NUDGE_VALENCE_EXCLUDE=-0.5
# Owner self-identity: your OWN contact_id(s) / handle identifier(s), comma or
# space separated, so your own self-chat is never surfaced as a nudge (default
# empty). NUDGE_SHORTCODE_MAX_DIGITS: all-digit handles this short are treated as
# automated SMS shortcodes (e.g. 22022) and excluded; real numbers are unaffected.
# NUDGE_OWNER_CONTACT_IDS=
# NUDGE_OWNER_HANDLES=
# NUDGE_SHORTCODE_MAX_DIGITS=6
# faded_initiator: fires when the counterparty's trailing-window initiation
# share falls to <= this fraction of their all-time share, for dyads with at
# least MIN_SESSIONS lifetime sessions, over a WINDOW_DAYS trailing window.
# NUDGE_FADED_INIT_DROP=0.5
# NUDGE_FADED_INIT_MIN_SESSIONS=10
# NUDGE_FADED_INIT_WINDOW_DAYS=90
# Urgency = kind_weight * exp(-age_days/halflife * ln2), age from the corpus's
# latest message.
# NUDGE_URGENCY_HALFLIFE_DAYS=30
# Per-kind urgency weights (JSON; a partial object merges over the defaults).
# NUDGE_KIND_WEIGHTS={"unanswered_question": 1.0, "faded_initiator": 0.7, "dormant_tie": 0.6, "dropped_plan": 0.9, "unreciprocated_goodnews": 0.5}
# Hard cap on get_loose_threads rows.
# NUDGE_MAX_RESULTS=5
# --- end feature: nudges ---
# --- feature: drift ---
# --- Relationship drift (drift.py) ---
# Opt-in. DRIFT_ENABLED defaults false: `make pipeline` includes the drift step
# unconditionally, but drift.py exits immediately and builds nothing until this
# is turned on. Accepts 1/true/yes/on.
# DRIFT_ENABLED=false
# Dyad inclusion gates and the per-signal minimum valid months (robust_slope
# needs >= 4 points, so keep DRIFT_MIN_VALID_MONTHS >= 4).
# DRIFT_MIN_MESSAGES=100
# DRIFT_MIN_MONTHS=4
# DRIFT_MIN_VALID_MONTHS=4
# DRIFT_MIN_SESSIONS=5
# Bootstrap CI level for every trend; a CI still spanning 0 contributes 0.
# DRIFT_SLOPE_CI=0.05
# The two JSON-valued vars (parsed once in config.py; malformed JSON raises).
# HEURISTIC defaults -- hand-tuned, NOT empirically validated; no study says this
# composite tracks real relationship drift. Biased toward the always-present
# message trio (volume/reciprocity/latency); silence weighted lowest (it can
# never call a decline on its own). Re-tune freely (a change re-hashes -> rebuild).
# DRIFT_WEIGHTS map each signal to its composite weight (renormalized over the
# signals actually present for a dyad):
# DRIFT_WEIGHTS={"volume": 0.22, "reciprocity": 0.22, "latency": 0.16, "silence": 0.06, "valence": 0.14, "depth": 0.10, "initiation": 0.10}
# DRIFT_PHASE_THRESHOLDS: drift_score cutoffs for the phase label (conservative
# on purpose -- a false "fading" is costlier than a missed one), plus the
# days-since-last-message that marks a dyad dormant.
# DRIFT_PHASE_THRESHOLDS={"thriving": 0.10, "steady": 0.35, "cooling": 0.60, "dormant_days": 90}
# --- end feature: drift ---
# --- feature: persona ---
# --- Voiceprint (voiceprint.py) ---
# Card confidence gate: a voiceprint reads 'high' only when it clears ALL
# THREE, else 'low'.
# VOICEPRINT_MIN_MESSAGES=500
# VOICEPRINT_MIN_REPLY_PAIRS=8
# VOICEPRINT_MIN_MONTHS=3
# HARD floor: below this many of the member's own messages a profile is noise,
# so it is neither built nor returned (get_voiceprint declines with a coverage
# note). Distinct from the high/low gate above.
# VOICEPRINT_MIN_RETURN_MESSAGES=30
# V2 (draft_reply) per-call style-retrieval degrade floor -- a SEPARATE knob
# from the gate above, with a different job.
# VOICEPRINT_MIN_CONTEXT_PAIRS=4
# draft_reply declines (no stub) when less than this fraction of the generated
# draft survives ungrounded-term stripping.
# DRAFT_MIN_SURVIVING_FRACTION=0.5
# Date-scoped get_voiceprint recompute: min messages in range to trust (else
# flagged), and the raw-scan ceiling above which it asks you to narrow the range.
# VOICEPRINT_MIN_RANGE_MESSAGES=200
# VOICEPRINT_SCAN_MAX_MESSAGES=20000
# Max seconds between two same-sender messages for them to count as one burst.
# VOICEPRINT_BURST_GAP_SECONDS=120
#
# --- V5 simulate_contact (query_tools/persona.py; RES-69) ---
# The highest-risk persona leg: ESTIMATE how a contact might reply in their
# voice, or talk to your PAST SELF as of a date. OFF BY DEFAULT and gated at
# REGISTRATION -- when false the schema is never registered, so the model can
# never call it (the repo's one reliable stop). Turning it on is a persistent
# opt-in; the per-call `acknowledged` param is a UX flow, NOT the boundary.
# PERSONA_SIM_ENABLED=false
# Hard deceased/grief denylist of `contacts.id` (comma/space separated). The
# tool hard-refuses these in code and never generates. Default-allow. There is
# no reliable automatic deceased detection from chat.db -- this manual list is
# the floor. Parsed like the other consent id-lists (tolerant).
# PERSONA_SIM_BLOCK_IDS=
# Soft deceased/dormant heuristic (a fail-open warning, never a block): fires
# when the contact's last message to you is older than PERSONA_SIM_DORMANT_DAYS
# AND you have since sent >= PERSONA_SIM_ONESIDED_MIN_MSGS messages with no reply.
# PERSONA_SIM_DORMANT_DAYS=365
# PERSONA_SIM_ONESIDED_MIN_MSGS=3
# --- end feature: persona ---

# --- feature: conflict ---
# --- Conflict core (conflict_detect.py; RES-46 / C1) ---
# Deterministic tense-stretch finder + eval-gated escalation labels. Model
# knobs follow the STANDARD inherit-from-CHAT rule (empty = CHAT_MODEL /
# CHAT_THINK / CHAT_TIMEOUT). Recorded as ingest_state `conflict_model`;
# mixing models in one conflicts table is refused (reset_db.py to switch).
# NOTE: like nudges, leaving CONFLICT_THINK unset inherits the flag-omitted
# default, which makes gemma4 run a FULL reasoning pass on EVERY per-turn
# label (up to CONFLICT_MAX_LABEL_TURNS per conflict). Set it false, like
# ANNOTATE/TOPIC/WRAPPED_THINK. For a faster run: conflict_detect.py --no-llm
# (deterministic windows only, zero LLM calls) or --max-label-turns N.
# CONFLICT_MODEL=
# CONFLICT_THINK=false
# CONFLICT_TIMEOUT=
# Latency-withdrawal gate (F2 survival estimator over raw reply gaps): a
# window qualifies when P(gap > Q hours) in-window >= FRAC and >= 3x the
# dyad's trailing-90-day baseline fraction.
# CONFLICT_LATENCY_Q_HOURS=9
# CONFLICT_LATENCY_FRAC=0.5
# Volume collapse: window daily rate <= (1 - X) * trailing-8-week median rate.
# CONFLICT_VOLUME_COLLAPSE=0.6
# Gap (hours) inside a window that sets off_text_flag (moved off-channel;
# forbids a resolution verdict downstream).
# CONFLICT_OFF_TEXT_GAP_HOURS=6
# Min valence drop (source='llm' chunks only) before valence corroboration
# boosts a window's rank. Gates ranking, never detection.
# CONFLICT_MIN_VALENCE_DROP=0.4
# Floor on the model's uncalibrated per-turn label confidence; below it the
# label row is dropped. Run `annotate.py --quality balanced --upgrade-distilled`
# to light valence corroboration on the chats you care about.
# CONFLICT_LABEL_CONF_FLOOR=0.7
# Cosine threshold consumed later by C3 (conflict tracing); declared here.
# CONFLICT_TRACE_SIM_THRESHOLD=0.65
# Internal: distinct deterministic signals a window must trip to be written,
# and the per-conflict cap on LLM-labeled turns.
# CONFLICT_MIN_SIGNALS=2
# CONFLICT_MAX_LABEL_TURNS=12
# DV-suppression floor for diagnose_conflict (C2). 'on' (default) screens each
# conflict window's full text for high-risk power-and-control markers; on a hit
# it withholds ONLY the aggressor/role output (the mechanical scorecard still
# returns) and appends a hotline resource footer. 'off' restores role analysis
# but still appends the footer on a hit. chat.py --no-dv-screen bypasses it for
# one run. The hit is never persisted.
# CONFLICT_DV_SCREEN=on
# --- end feature: conflict ---

# --- feature: nudges ---
# --- Dormant-tie nudges (loose_ends.py dormant_tie detector; RES-55 / N2) ---
# "Once-close" = top fraction of eligible dyads by a z-scored closeness
# composite over the trailing 12 months (z(messages) + z(mean chunk depth) +
# z(LSM)); a dyad is eligible when it is a direct chat with at least
# MIN_MESSAGES real messages in that window.
# NUDGE_DORMANT_TOP_FRAC=0.2
# NUDGE_DORMANT_MIN_MESSAGES=200
# "Overdue" = the current silence exceeds BOTH the dyad's own p90 inter-message
# gap (full gap distribution, not reply-latency median) AND this absolute floor
# in days (so a short-cadence pair does not fire on a two-week lull).
# NUDGE_DORMANT_MIN_GAP_DAYS=21
# Dormant-tie nudges are a sensitive class: they are detected and written like
# any other, but stay HIDDEN from get_loose_threads until you opt in once with
# `loose_ends.py --acknowledge-reconnect` (sets the durable ingest_state key
# nudges_reconnect_ack). No env var -- it is a one-time explicit CLI action.
# --- end feature: nudges ---
# --- feature: wellbeing ---
# --- Wellbeing trajectory (query_tools/analytics_wellbeing.py; RES-61 / W2) ---
# Pinned gates for the deterministic change-point core (wellbeing.py). All are
# conservative on purpose -- raising a threshold only makes get_language_trajectory
# quieter (false positives are the enemy). WELLBEING_MIN_MARKER_HITS is the
# lifetime raw-hit floor a marker must clear before it is analyzed at all.
# WELLBEING_Z_THRESHOLD=3.5
# WELLBEING_MIN_RUN_MONTHS=3
# WELLBEING_MIN_BASELINE_MONTHS=12
# WELLBEING_FAMILY_CAP=2.0
# WELLBEING_CUSUM_K=0.5
# WELLBEING_CUSUM_H=4.0
# WELLBEING_MIN_MARKER_HITS=30
# Grounding excerpts returned per firing window.
# WELLBEING_N_EXAMPLES=3
# Corpus floor: below this many words in scope, no analysis runs.
# MIN_WELLBEING_WORDS=5000
# Per-contact deny list (contacts.id values, comma/space separated). Default-open:
# empty (the default) analyzes any named contact; list an id to refuse that
# contact in code. Self is never affected.
# WELLBEING_DENY_IDS=
# --- end feature: wellbeing ---

# --- feature: conflict ---
# --- C3 cross-chat conflict trace (RES-52) ---
# OFF BY DEFAULT, gated at REGISTRATION: trace_conflict_across_chats is only
# offered to the model when CONFLICT_TRACE_ENABLED is truthy -- its schema is
# withheld otherwise (the repo's one reliable way to stop a tool call). Turning
# it on is your explicit, persistent opt-in; the tool's per-call `consent` param
# is a UX device, NOT the security boundary. Nothing is ever persisted (there is
# no conflict_links table). Accepts 1/true/yes/on.
# CONFLICT_TRACE_ENABLED=false
# Day-buffer padded onto each side of a conflict window when scanning other
# chats for spillover.
# CONFLICT_TRACE_BUFFER_DAYS=2
# --- end feature: conflict ---
# --- feature: nudges ---
# --- Unanswered-question nudges (loose_ends.py unanswered_question detector; RES-56 / N3) ---
# A 1:1 session that ended on the OTHER person's genuine, unanswered question:
# it ends with '?', its trimmed text is at least MIN_CHARS long, and its final
# sentence misses the pinned rhetorical/pleasantry stoplist in code. A loose
# end only if it went unanswered for longer than the dyad's own cadence --
# suppressed iff a self-reply lands within anchor + max(the dyad's p90
# inter-message gap, GRACE_HOURS); a later reply does not suppress (it is
# recorded in evidence). The 72h floor keeps a fast-cadence pair from firing on
# an afternoon's silence.
# NUDGE_QUESTION_MIN_CHARS=12
# NUDGE_QUESTION_GRACE_HOURS=72
# A question answered after the deadline (just late) is resolved, not an open
# loose end; it is dropped by default. Set true to keep the "you replied slowly"
# signal (rides evidence.answered_late).
# NUDGE_QUESTION_INCLUDE_ANSWERED_LATE=false
# A question unanswered longer than this many days is too stale to be a nudge.
# NUDGE_QUESTION_MAX_AGE_DAYS=365
# --- end feature: nudges ---
# --- feature: nudges ---
# --- N4 nudges: dropped_plan + unreciprocated_goodnews (RES-57) ---
# Both detectors ship HARD-GATED (default OFF); the off path runs no LLM and
# does not consult the eval gate.
#
# dropped_plan / unmet_commitment: an FTS cue-phrase pre-filter feeds a Searle-
# style LLM verifier (fulfilled | unfulfilled | UNKNOWN; UNKNOWN suppresses).
# Even when enabled, a row is written only if the F4 precision gate clears the
# dropped_plan class (>= 0.85); an absent verdict suppresses. The verifier
# passes think=NUDGES_THINK -- keep it false/omitted for gemma (a one-word
# verdict does not warrant a reasoning pass). Accepts 1/true/yes/on.
# NUDGE_DROPPED_PLAN_ENABLED=false
# Messages after the anchor shown to the verifier as context.
# NUDGE_PLAN_CONTEXT_MSGS=30
# unreciprocated_goodnews: reads response_class from chunk_annotations.
# events_json (source='llm' rows only) and fires when good news drew a non
# active-constructive response. Coverage is reported in evidence so "no good
# news" is never confused with "not annotated". Opt-in; precision is inherited
# from the gemma annotations, not SQL-exact. Accepts 1/true/yes/on.
# NUDGE_GOODNEWS_ENABLED=false
# Recency floor: good news older than this many days is not actionable and is
# never written (its urgency decays to ~0 anyway).
# NUDGE_GOODNEWS_MAX_AGE_DAYS=90
# --- end feature: nudges ---

# Copy to .env and uncomment/edit any values you want to override.
# All variables here have working defaults (see config.py) -- .env is optional.

# --- DB paths ---
# SOURCE_DB=source_data/chat.db
# SNAPSHOT_DB=source_data/chat_snapshot.db
# TARGET_DB=imessage_analysis.db
# ADDRESS_BOOK_PATH=source_data/address_book.abcddb

# --- CLI progress ---
# How the batch CLIs report progress. 'auto' draws a live bar on a terminal
# and falls back to periodic plain lines when piped; 'plain' forces the
# lines; 'off' silences progress (start/summary lines still print).
# PROGRESS_STYLE=auto
# Items between progress lines in plain mode. Never affects commit cadence.
# PROGRESS_LOG_EVERY=200

# --- Ollama connectivity ---
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434
# OLLAMA_EMBED_PATH=/api/embed
# OLLAMA_CHAT_PATH=/api/chat
# OLLAMA_TIMEOUT=60
# CHAT_TIMEOUT=300

# --- Models ---
# Every value shown after '=' is the built-in default from config.py, so an
# uncommented line only matters if you change it. CHAT_MODEL is the one knob
# that moves the others: ANNOTATE_MODEL / TOPIC_MODEL / WRAPPED_MODEL (and
# their *_THINK / *_TIMEOUT siblings) inherit from it when left empty.
# EMBED_MODEL=nomic-embed-text
# CHAT_MODEL=gemma4:26b-a4b-it-qat
# Thinking pass for thinking-capable chat models (e.g. qwen3): false disables
# it (much faster), true forces it on. Default is unset = the model's own
# default (the flag is omitted entirely, which some models require).
# CHAT_THINK=

# --- Tunables ---
# Embedding dimension: leave unset to auto-detect the model's native size.
# Setting it truncates+renormalizes (Matryoshka -- MRL-trained models only).
# EMBED_DIM=
# Task prefixes for the embed model. Defaults match nomic-embed-text; set
# both to '' (empty) for models without task prefixes.
# EMBED_DOC_PREFIX="search_document: "
# EMBED_QUERY_PREFIX="search_query: "
# EMBED_BATCH_SIZE=64
# EMBED_MAX_WORKERS=4
# Embedded chunks between commits (resumability granularity on interrupt).
# EMBED_COMMIT_EVERY=200
# MAX_TOOL_ITERATIONS=20
# TOOL_RESULT_MAX_CHARS=60000
# Minimum gap (minutes) between same-sender messages for a double-text.
# DOUBLE_TEXT_MIN_MINUTES=10

# --- Analytics: sessions & response dynamics ---
# Silence (minutes) that closes a session row in the sessions table.
# SESSION_GAP_MINUTES=60
# A session starting after at least this much silence is an initiation.
# INITIATION_GAP_HOURS=12
# Max gap (minutes) for a reply to count as an adjacency in group dynamics.
# ADJACENCY_MINUTES=5
# Local-clock hours [start, end) counted as "late night".
# LATE_NIGHT_START_HOUR=0
# LATE_NIGHT_END_HOUR=5
# IANA timezone for hour/weekday bucketing; empty = system local timezone.
# LOCAL_TZ=America/New_York

# --- Analytics: lexicon & dyad terms ---
# DYAD_TERM_MIN_USES=5
# DYAD_TERM_MIN_LIFT=5.0
# DYAD_TERM_TOP_K=50

# --- Batch annotation (annotate.py) ---
# Default empty = inherit CHAT_MODEL (so: gemma4:26b-a4b-it-qat). Mixing
# models in chunk_annotations is refused -- switching this means emptying the
# table first.
# ANNOTATE_MODEL=
# ANNOTATE_TOP_DYADS=20
# ANNOTATE_COMMIT_EVERY=50
# Speed/quality tradeoff: distilled | fast | balanced | max (see config.py;
# --quality overrides per run). distilled = LLM seed sample + kNN classify
# the whole corpus from embeddings.
# ANNOTATE_QUALITY=distilled
# Preset overrides. ANNOTATE_THINK is Ollama's reasoning control: low/medium/
# high for effort-level models (gpt-oss), true/false for toggle models
# (qwen3) -- gpt-oss returns EMPTY output for false, use the levels (an empty
# reply to think=false is detected once and the run continues without it).
# 'omit'/'none' send no think flag at all, which is NOT the same as false.
# ANNOTATE_BATCH_SIZE = chunks per LLM request (fast preset uses 8).
# Both default empty/0 = use the ANNOTATE_QUALITY preset's own value.
# ANNOTATE_THINK=
# ANNOTATE_BATCH_SIZE=0
# Per-request timeout for the annotate/terms/seed passes; unset = CHAT_TIMEOUT.
# ANNOTATE_TIMEOUT=
# Concurrent LLM requests (needs OLLAMA_NUM_PARALLEL>1 server-side to pay
# off -- `make ollama-start` sets 4; ~2x measured).
# ANNOTATE_WORKERS=4
# Distilled preset: LLM seeds to accumulate before classifying, and the
# number of nearest seeds that vote per chunk.
# ANNOTATE_SEED_TARGET=450
# ANNOTATE_KNN_K=10

# --- Dyad-term curation (annotate.py --terms) ---
# Term curation is NOT a --quality tier and does NOT read ANNOTATE_THINK: one
# term is a four-way choice answered in one word, so a reasoning pass is pure
# latency (gemma4, same verdict: think=low 282.6s vs think=false 26.2s).
# Empty = false; set 'low' on gpt-oss (it returns EMPTY output for false --
# detected once, after which the run continues with no reasoning control, so
# a mismatch costs a warning rather than a parked corpus). 'omit'/'none'
# sends no flag at all: the model's default reasoning (gemma4: 52.0s).
# ANNOTATE_TERMS_THINK=
# Terms per LLM request (~25x fewer requests; a batch never spans chats).
# ANNOTATE_TERMS_BATCH_SIZE=25
# Failed attempts before a term is parked (dyad_terms.curate_failures) rather
# than retried by every later run. Only a term's own dedicated request can
# fail it, and a run where nothing succeeds aborts without recording any.
# --terms --retry-failed unparks them.
# ANNOTATE_TERMS_MAX_FAILURES=3

# --- Topic clustering (topics.py) ---
# Default empty = inherit CHAT_MODEL (so: gemma4:26b-a4b-it-qat). Unlike
# ANNOTATE_MODEL, mixing models across runs is fine -- a rebuild just replaces
# the clustering.
# TOPIC_MODEL=
# Thinking pass for the label pass; default empty = inherit CHAT_THINK (which
# itself defaults to the model's own default). Worth forcing false on a
# thinking model: the label is one short JSON object, so thinking is pure
# latency (85s -> 3.2s per call on qwen3:4b).
# TOPIC_THINK=
# Default empty = inherit CHAT_TIMEOUT (so: 300 seconds).
# TOPIC_TIMEOUT=
# TOPIC_K=50
# TOPIC_KMEANS_ITERS=15
# Chunks shown per cluster, ranked by similarity to the centroid. Below ~30
# the samples are dominated by the cluster's shortest messages and labels
# degrade to "General Conversation"; much above it, the prompt risks the
# context window (see config.py).
# TOPIC_LABEL_SAMPLES=30

# --- wrapped.py ---
# Default empty = inherit CHAT_MODEL (so: gemma4:26b-a4b-it-qat).
# WRAPPED_MODEL=
# Default empty = inherit CHAT_THINK / CHAT_TIMEOUT (so: model default, 300s).
# WRAPPED_THINK=
# WRAPPED_TIMEOUT=
# WRAPPED_TOP_CONTACTS=8
# Auto-exclude contacts silent this long before corpus end (see config.py).
# WRAPPED_SILENT_MONTHS=6
# WRAPPED_SILENT_MIN_MESSAGES=200

# --- Conversation chunking ---
# CHUNK_GAP_MINUTES=60
# CHUNK_MAX_CHARS=2000
# CHUNK_MIN_CHARS=10
# CHUNK_OVERLAP_MESSAGES=2

# --- Eval gates (eval/evalkit label/gate; RES-70 / F4) ---
# Minimum hand labels a measurement gate needs before a class may be cleared.
# Per-class gold-support floor for kappa tasks (conflict_labels); below it a
# class scores None and is never marked passed. Pinned at 50.
# EVAL_GATE_MIN_LABELS=50
# The floor for precision (detector) tasks (dropped_plan): gold positives a
# class needs in the labeled sample before its precision may clear. Pinned 40.
# EVAL_GATE_MIN_PRECISION_POSITIVES=40
# --- feature: nudges ---
# --- Loose Ends / nudges (loose_ends.py) ---
# Model/think/timeout for the one-line nudge_text narration ONLY (detectors are
# model-free SQL). Default empty = inherit CHAT_MODEL / CHAT_THINK / CHAT_TIMEOUT.
# NOTE: with gemma4, leave NUDGES_THINK unset and it inherits the flag-omitted
# default, which makes gemma run a FULL reasoning pass on every one-liner (~11x
# latency for identical output -- a 20-thread run goes from ~10min to hours). Set
# it false, like ANNOTATE/TOPIC/WRAPPED_THINK, unless your narration model needs
# the flag omitted.
# NUDGES_MODEL=
# NUDGES_THINK=false
# NUDGES_TIMEOUT=
# Stage-0 auto-exclusion: most-recent llm-annotated exchange with mean valence
# <= this is dropped (only source='llm' chunk_annotations count).
# NUDGE_VALENCE_EXCLUDE=-0.5
# Owner self-identity: your OWN contact_id(s) / handle identifier(s), comma or
# space separated, so your own self-chat is never surfaced as a nudge (default
# empty). NUDGE_SHORTCODE_MAX_DIGITS: all-digit handles this short are treated as
# automated SMS shortcodes (e.g. 22022) and excluded; real numbers are unaffected.
# NUDGE_OWNER_CONTACT_IDS=
# NUDGE_OWNER_HANDLES=
# NUDGE_SHORTCODE_MAX_DIGITS=6
# faded_initiator: fires when the counterparty's trailing-window initiation
# share falls to <= this fraction of their all-time share, for dyads with at
# least MIN_SESSIONS lifetime sessions, over a WINDOW_DAYS trailing window.
# NUDGE_FADED_INIT_DROP=0.5
# NUDGE_FADED_INIT_MIN_SESSIONS=10
# NUDGE_FADED_INIT_WINDOW_DAYS=90
# Urgency = kind_weight * exp(-age_days/halflife * ln2), age from the corpus's
# latest message.
# NUDGE_URGENCY_HALFLIFE_DAYS=30
# Per-kind urgency weights (JSON; a partial object merges over the defaults).
# NUDGE_KIND_WEIGHTS={"unanswered_question": 1.0, "faded_initiator": 0.7, "dormant_tie": 0.6, "dropped_plan": 0.9, "unreciprocated_goodnews": 0.5, "inferred_occasion": 0.8}
# Hard cap on get_loose_threads rows.
# NUDGE_MAX_RESULTS=5
# --- end feature: nudges ---
# --- feature: drift ---
# --- Relationship drift (drift.py) ---
# Opt-in. DRIFT_ENABLED defaults false: `make pipeline` includes the drift step
# unconditionally, but drift.py exits immediately and builds nothing until this
# is turned on. Accepts 1/true/yes/on.
# DRIFT_ENABLED=false
# Dyad inclusion gates and the per-signal minimum valid months (robust_slope
# needs >= 4 points, so keep DRIFT_MIN_VALID_MONTHS >= 4).
# DRIFT_MIN_MESSAGES=100
# DRIFT_MIN_MONTHS=4
# DRIFT_MIN_VALID_MONTHS=4
# DRIFT_MIN_SESSIONS=5
# Bootstrap CI level for every trend; a CI still spanning 0 contributes 0.
# DRIFT_SLOPE_CI=0.05
# The two JSON-valued vars (parsed once in config.py; malformed JSON raises).
# HEURISTIC defaults -- hand-tuned, NOT empirically validated; no study says this
# composite tracks real relationship drift. Biased toward the always-present
# message trio (volume/reciprocity/latency); silence weighted lowest (it can
# never call a decline on its own). Re-tune freely (a change re-hashes -> rebuild).
# DRIFT_WEIGHTS map each signal to its composite weight (renormalized over the
# signals actually present for a dyad):
# DRIFT_WEIGHTS={"volume": 0.22, "reciprocity": 0.22, "latency": 0.16, "silence": 0.06, "valence": 0.14, "depth": 0.10, "initiation": 0.10}
# DRIFT_PHASE_THRESHOLDS: drift_score cutoffs for the phase label (conservative
# on purpose -- a false "fading" is costlier than a missed one), plus the
# days-since-last-message that marks a dyad dormant.
# DRIFT_PHASE_THRESHOLDS={"thriving": 0.10, "steady": 0.35, "cooling": 0.60, "dormant_days": 90}
# --- end feature: drift ---
# --- feature: persona ---
# --- Voiceprint (voiceprint.py) ---
# Card confidence gate: a voiceprint reads 'high' only when it clears ALL
# THREE, else 'low'.
# VOICEPRINT_MIN_MESSAGES=500
# VOICEPRINT_MIN_REPLY_PAIRS=8
# VOICEPRINT_MIN_MONTHS=3
# HARD floor: below this many of the member's own messages a profile is noise,
# so it is neither built nor returned (get_voiceprint declines with a coverage
# note). Distinct from the high/low gate above.
# VOICEPRINT_MIN_RETURN_MESSAGES=30
# V2 (draft_reply) per-call style-retrieval degrade floor -- a SEPARATE knob
# from the gate above, with a different job.
# VOICEPRINT_MIN_CONTEXT_PAIRS=4
# draft_reply declines (no stub) when less than this fraction of the generated
# draft survives ungrounded-term stripping.
# DRAFT_MIN_SURVIVING_FRACTION=0.5
# Date-scoped get_voiceprint recompute: min messages in range to trust (else
# flagged), and the raw-scan ceiling above which it asks you to narrow the range.
# VOICEPRINT_MIN_RANGE_MESSAGES=200
# VOICEPRINT_SCAN_MAX_MESSAGES=20000
# Max seconds between two same-sender messages for them to count as one burst.
# VOICEPRINT_BURST_GAP_SECONDS=120
#
# --- V5 simulate_contact (query_tools/persona.py; RES-69) ---
# The highest-risk persona leg: ESTIMATE how a contact might reply in their
# voice, or talk to your PAST SELF as of a date. OFF BY DEFAULT and gated at
# REGISTRATION -- when false the schema is never registered, so the model can
# never call it (the repo's one reliable stop). Turning it on is a persistent
# opt-in; the per-call `acknowledged` param is a UX flow, NOT the boundary.
# PERSONA_SIM_ENABLED=false
# Hard deceased/grief denylist of `contacts.id` (comma/space separated). The
# tool hard-refuses these in code and never generates. Default-allow. There is
# no reliable automatic deceased detection from chat.db -- this manual list is
# the floor. Parsed like the other consent id-lists (tolerant).
# PERSONA_SIM_BLOCK_IDS=
# Soft deceased/dormant heuristic (a fail-open warning, never a block): fires
# when the contact's last message to you is older than PERSONA_SIM_DORMANT_DAYS
# AND you have since sent >= PERSONA_SIM_ONESIDED_MIN_MSGS messages with no reply.
# PERSONA_SIM_DORMANT_DAYS=365
# PERSONA_SIM_ONESIDED_MIN_MSGS=3
# --- end feature: persona ---

# --- feature: conflict ---
# --- Conflict core (conflict_detect.py; RES-46 / C1) ---
# Deterministic tense-stretch finder + eval-gated escalation labels. Model
# knobs follow the STANDARD inherit-from-CHAT rule (empty = CHAT_MODEL /
# CHAT_THINK / CHAT_TIMEOUT). Recorded as ingest_state `conflict_model`;
# mixing models in one conflicts table is refused (reset_db.py to switch).
# NOTE: like nudges, leaving CONFLICT_THINK unset inherits the flag-omitted
# default, which makes gemma4 run a FULL reasoning pass on EVERY per-turn
# label (up to CONFLICT_MAX_LABEL_TURNS per conflict). Set it false, like
# ANNOTATE/TOPIC/WRAPPED_THINK. For a faster run: conflict_detect.py --no-llm
# (deterministic windows only, zero LLM calls) or --max-label-turns N.
# CONFLICT_MODEL=
# CONFLICT_THINK=false
# CONFLICT_TIMEOUT=
# Latency-withdrawal gate (F2 survival estimator over raw reply gaps): a
# window qualifies when P(gap > Q hours) in-window >= FRAC and >= 3x the
# dyad's trailing-90-day baseline fraction.
# CONFLICT_LATENCY_Q_HOURS=9
# CONFLICT_LATENCY_FRAC=0.5
# Volume collapse: window daily rate <= (1 - X) * trailing-8-week median rate.
# CONFLICT_VOLUME_COLLAPSE=0.6
# Gap (hours) inside a window that sets off_text_flag (moved off-channel;
# forbids a resolution verdict downstream).
# CONFLICT_OFF_TEXT_GAP_HOURS=6
# Min valence drop (source='llm' chunks only) before valence corroboration
# boosts a window's rank. Gates ranking, never detection.
# CONFLICT_MIN_VALENCE_DROP=0.4
# Floor on the model's uncalibrated per-turn label confidence; below it the
# label row is dropped. Run `annotate.py --quality balanced --upgrade-distilled`
# to light valence corroboration on the chats you care about.
# CONFLICT_LABEL_CONF_FLOOR=0.7
# Cosine threshold consumed later by C3 (conflict tracing); declared here.
# CONFLICT_TRACE_SIM_THRESHOLD=0.65
# Internal: distinct deterministic signals a window must trip to be written,
# and the per-conflict cap on LLM-labeled turns.
# CONFLICT_MIN_SIGNALS=2
# CONFLICT_MAX_LABEL_TURNS=12
# DV-suppression floor for diagnose_conflict (C2). 'on' (default) screens each
# conflict window's full text for high-risk power-and-control markers; on a hit
# it withholds ONLY the aggressor/role output (the mechanical scorecard still
# returns) and appends a hotline resource footer. 'off' restores role analysis
# but still appends the footer on a hit. chat.py --no-dv-screen bypasses it for
# one run. The hit is never persisted.
# CONFLICT_DV_SCREEN=on
# --- end feature: conflict ---

# --- feature: nudges ---
# --- Dormant-tie nudges (loose_ends.py dormant_tie detector; RES-55 / N2) ---
# "Once-close" = top fraction of eligible dyads by a z-scored closeness
# composite over the trailing 12 months (z(messages) + z(mean chunk depth) +
# z(LSM)); a dyad is eligible when it is a direct chat with at least
# MIN_MESSAGES real messages in that window.
# NUDGE_DORMANT_TOP_FRAC=0.2
# NUDGE_DORMANT_MIN_MESSAGES=200
# "Overdue" = the current silence exceeds BOTH the dyad's own p90 inter-message
# gap (full gap distribution, not reply-latency median) AND this absolute floor
# in days (so a short-cadence pair does not fire on a two-week lull).
# NUDGE_DORMANT_MIN_GAP_DAYS=21
# Dormant-tie nudges are a sensitive class: they are detected and written like
# any other, but stay HIDDEN from get_loose_threads until you opt in once with
# `loose_ends.py --acknowledge-reconnect` (sets the durable ingest_state key
# nudges_reconnect_ack). No env var -- it is a one-time explicit CLI action.
# --- end feature: nudges ---
# --- feature: wellbeing ---
# --- Wellbeing trajectory (query_tools/analytics_wellbeing.py; RES-61 / W2) ---
# Pinned gates for the deterministic change-point core (wellbeing.py). All are
# conservative on purpose -- raising a threshold only makes get_language_trajectory
# quieter (false positives are the enemy). WELLBEING_MIN_MARKER_HITS is the
# lifetime raw-hit floor a marker must clear before it is analyzed at all.
# WELLBEING_Z_THRESHOLD=3.5
# WELLBEING_MIN_RUN_MONTHS=3
# WELLBEING_MIN_BASELINE_MONTHS=12
# WELLBEING_FAMILY_CAP=2.0
# WELLBEING_CUSUM_K=0.5
# WELLBEING_CUSUM_H=4.0
# WELLBEING_MIN_MARKER_HITS=30
# Grounding excerpts returned per firing window.
# WELLBEING_N_EXAMPLES=3
# Corpus floor: below this many words in scope, no analysis runs.
# MIN_WELLBEING_WORDS=5000
# Per-contact deny list (contacts.id values, comma/space separated). Default-open:
# empty (the default) analyzes any named contact; list an id to refuse that
# contact in code. Self is never affected.
# WELLBEING_DENY_IDS=
# --- end feature: wellbeing ---

# --- feature: conflict ---
# --- C3 cross-chat conflict trace (RES-52) ---
# OFF BY DEFAULT, gated at REGISTRATION: trace_conflict_across_chats is only
# offered to the model when CONFLICT_TRACE_ENABLED is truthy -- its schema is
# withheld otherwise (the repo's one reliable way to stop a tool call). Turning
# it on is your explicit, persistent opt-in; the tool's per-call `consent` param
# is a UX device, NOT the security boundary. Nothing is ever persisted (there is
# no conflict_links table). Accepts 1/true/yes/on.
# CONFLICT_TRACE_ENABLED=false
# Day-buffer padded onto each side of a conflict window when scanning other
# chats for spillover.
# CONFLICT_TRACE_BUFFER_DAYS=2
# --- end feature: conflict ---
# --- feature: nudges ---
# --- Unanswered-question nudges (loose_ends.py unanswered_question detector; RES-56 / N3) ---
# A 1:1 session that ended on the OTHER person's genuine, unanswered question:
# it ends with '?', its trimmed text is at least MIN_CHARS long, and its final
# sentence misses the pinned rhetorical/pleasantry stoplist in code. A loose
# end only if it went unanswered for longer than the dyad's own cadence --
# suppressed iff a self-reply lands within anchor + max(the dyad's p90
# inter-message gap, GRACE_HOURS); a later reply does not suppress (it is
# recorded in evidence). The 72h floor keeps a fast-cadence pair from firing on
# an afternoon's silence.
# NUDGE_QUESTION_MIN_CHARS=12
# NUDGE_QUESTION_GRACE_HOURS=72
# A question answered after the deadline (just late) is resolved, not an open
# loose end; it is dropped by default. Set true to keep the "you replied slowly"
# signal (rides evidence.answered_late).
# NUDGE_QUESTION_INCLUDE_ANSWERED_LATE=false
# A question unanswered longer than this many days is too stale to be a nudge.
# NUDGE_QUESTION_MAX_AGE_DAYS=365
# --- end feature: nudges ---
# --- feature: nudges ---
# --- Inferred-occasion nudges (loose_ends.py inferred_occasion detector; N5) ---
# A recurring birthday/anniversary a 1:1 dyad marks, inferred from congratulatory
# messages on the SAME calendar date across at least this many distinct years.
# This detector fills loose_threads.due_by (the next upcoming occurrence).
#
NUDGE_OCCASION_MIN_YEARS=2

# --- Web layer (optional API + frontend) ---
# Settings for the optional FastAPI backend (api/) + Vite/React frontend
# (frontend/). Install the deps with `make api-install` / `make web-install`;
# run with `make api-dev` / `make web-dev`. All values have working defaults.
# Separate app-state DB for the web chat's conversations/turns, kept out of the
# derived imessage_analysis.db so a re-ingest or reset-db never touches it.
# APP_DB=app.db
# Bind host for the FastAPI dev server. Loopback by default -- this is a
# local-first, single-user app; do not expose it on a public interface.
# API_HOST=127.0.0.1
# API_PORT=8000
# Comma-separated allowed CORS origins for the Vite dev frontend (default port
# 5173). Add your own origin here if you serve the frontend elsewhere.
# API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# --- end feature: web ---
