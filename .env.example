# Copy to .env and uncomment/edit any values you want to override.
# All variables here have working defaults (see config.py) -- .env is optional.

# --- DB paths ---
# SOURCE_DB=source_data/chat.db
# SNAPSHOT_DB=source_data/chat_snapshot.db
# TARGET_DB=imessage_analysis.db
# ADDRESS_BOOK_PATH=source_data/address_book.abcddb

# --- Ollama connectivity ---
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434
# OLLAMA_EMBED_PATH=/api/embed
# OLLAMA_EMBEDDINGS_PATH=/api/embeddings
# OLLAMA_CHAT_PATH=/api/chat
# OLLAMA_TIMEOUT=60
# CHAT_TIMEOUT=300

# --- Models ---
# EMBED_MODEL=gemma4:26b-a4b-it-qat
# CHAT_MODEL=gemma4:26b-a4b-it-qat

# --- Tunables ---
# EMBED_DIM=768
# EMBED_BATCH_SIZE=64
# EMBED_MAX_WORKERS=4
# MAX_TOOL_ITERATIONS=20
